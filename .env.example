# =========================
# Core Django
# =========================
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,tracknode.ru
TIME_ZONE=Europe/Moscow

# Optional for tracker/widget absolute links
PUBLIC_BASE_URL=http://localhost:9000
FRONTEND_URL=http://localhost:9003

# =========================
# Database (PostgreSQL)
# =========================
POSTGRES_DB=mini_saas
POSTGRES_USER=mini_saas
POSTGRES_PASSWORD=mini_saas
POSTGRES_HOST=db
POSTGRES_PORT=5432

# For local checks/tests without PostgreSQL
# DJANGO_DB_ENGINE=sqlite

# =========================
# Redis / Celery / Channels
# =========================
REDIS_URL=redis://redis:6379/1
CHANNELS_USE_INMEMORY=false

# =========================
# JWT
# =========================
JWT_ACCESS_MINUTES=10080
JWT_REFRESH_DAYS=60

# =========================
# Public API Rate Limits
# =========================
RATE_LIMIT_PUBLIC_LEAD=30/minute
RATE_LIMIT_PUBLIC_EVENT=120/minute
RATE_LIMIT_PUBLIC_ANALYTICS_EVENT=300/minute
RATE_LIMIT_PUBLIC_TELEGRAM_WEBHOOK=120/minute
RATE_LIMIT_PUBLIC_WIDGET_VARIANT=180/minute

# =========================
# Healthcheck
# =========================
HEALTHCHECK_CELERY_PING_ENABLED=true
HEALTHCHECK_REQUIRE_CELERY=false
HEALTHCHECK_CELERY_PING_TIMEOUT_SECONDS=1.5

# =========================
# Backups (pg_dump scaffold)
# =========================
BACKUP_ENABLED=false
BACKUP_STORAGE_DIR=/app/backups
BACKUP_KEEP_DAYS=14
BACKUP_PG_DUMP_PATH=pg_dump
BACKUP_SCHEDULE_HOUR=3
BACKUP_SCHEDULE_MINUTE=0

# =========================
# Email
# =========================
